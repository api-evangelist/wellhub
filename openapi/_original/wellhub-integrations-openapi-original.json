            "description": "The UUID of the job."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pagination cursor returned from the previous response. Omit to retrieve the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "OK. Returns a paginated list of job items.",
