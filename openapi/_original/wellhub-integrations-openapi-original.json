        "responses": {
          "201": {
            "description": "Created. Returns the newly created job's ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                },
                "example": {
                  "id": "d46fb00b-79b1-4a89-9bd6-523889d0417f"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Missing or invalid Bearer token.",
            "content": {
              "application/json": {
