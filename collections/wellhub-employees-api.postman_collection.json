      "item": [
        {
          "id": "315a9371-a829-41e7-8ee2-ab4c2f1ba589",
          "name": "List employees by company",
          "request": {
            "name": "List employees by company",
            "description": {
              "content": "Returns a paginated list of employees belonging to the specified company, identified by its tax ID. Only companies accessible to the authenticated entity are allowed.\n\n> **ℹ️ Availability.** This endpoint is available to **multi-entity clients** and **channel partners**. Single-entity clients should use `GET /v1/employees` instead.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "companies",
                ":company-tax-id",
                "employees"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Pagination cursor returned from the previous response. Omit to retrieve the first page."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "company-tax-id",
                  "description": "(Required) The tax ID of the company whose employees should be listed."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
